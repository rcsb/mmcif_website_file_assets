                        <xsd:documentation xml:lang="en">
Details about the layer line file.
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="experiment_id" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:string">

Total number of reflections used in data processing.
9744
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="number_marked_reject" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:integer">

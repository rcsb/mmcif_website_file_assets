      &lt;PDBx:dist_DH&gt;0.894&lt;/PDBx:dist_DH&gt;
      &lt;PDBx:dist_HA&gt;1.886&lt;/PDBx:dist_HA&gt;
      &lt;PDBx:publ_flag&gt;yes&lt;/PDBx:publ_flag&gt;

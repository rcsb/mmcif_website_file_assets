                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">
The identifier for the target atom to which the feature is assigned.
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="comp_id" minOccurs="1" maxOccurs="1" type="xsd:string">
                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">

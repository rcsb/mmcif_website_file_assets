                  </xsd:simpleType>
               </xsd:attribute>
               <xsd:attribute name="ordinal" use="required" type="xsd:integer">
                  <xsd:annotation>
                     <xsd:documentation xml:lang="en">
A unique identifier for the pdbx_audit_revision_details record.
1

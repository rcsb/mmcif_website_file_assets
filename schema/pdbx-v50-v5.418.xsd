   &lt;PDBx:pdbx_refln_signal_binning ordinal=&quot;3&quot;&gt;
      &lt;PDBx:upper_threshold&gt;19.00&lt;/PDBx:upper_threshold&gt;
   &lt;/PDBx:pdbx_refln_signal_binning&gt;
   &lt;PDBx:pdbx_refln_signal_binning ordinal=&quot;4&quot;&gt;

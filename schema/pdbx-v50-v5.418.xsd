This data item is a pointer to attribute id in category struct_asym in the
 STRUCT_ASYM category.
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
               </xsd:all>
               <xsd:attribute name="entity_inst_id" use="required" type="xsd:string">

&lt;PDBx:pdbx_struct_assembly_gen_depositor_infoCategory&gt;
   &lt;PDBx:pdbx_struct_assembly_gen_depositor_info id=&quot;1&quot;&gt;
      &lt;PDBx:assembly_id&gt;1&lt;/PDBx:assembly_id&gt;
      &lt;PDBx:asym_id_list&gt;A,B&lt;/PDBx:asym_id_list&gt;

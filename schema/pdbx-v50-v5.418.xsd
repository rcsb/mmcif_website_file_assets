                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">
Optional identifier of the first of the three atom sites that
define the angle.
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="auth_PDB_insert_id_2" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:string">
                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">

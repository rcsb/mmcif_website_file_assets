                  </xsd:annotation>
               </xsd:attribute>
               <xsd:attribute name="revision_ordinal" use="required" type="xsd:integer">
                  <xsd:annotation>
                     <xsd:documentation xml:lang="en">
A pointer to attribute ordinal in category pdbx_audit_revision_history 

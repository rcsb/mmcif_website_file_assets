                           <xsd:enumeration value="investigator" />
                        </xsd:restriction>
                     </xsd:simpleType>
                  </xsd:element>
                  <xsd:element name="state_province" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:string">

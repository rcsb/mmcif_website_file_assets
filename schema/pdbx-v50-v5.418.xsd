   &lt;/PDBx:pdbx_diffrn_reflns_shell&gt;
   &lt;PDBx:pdbx_diffrn_reflns_shell d_res_high=&quot;4.11&quot; d_res_low=&quot;5.18&quot; diffrn_id=&quot;1&quot;&gt;

The [1][2] element of the PDB ORIGX matrix.
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="origx13" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:decimal">
                     <xsd:annotation>

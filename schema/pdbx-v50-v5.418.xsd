The [1][3] element of the PDB ORIGX matrix.
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="origx21" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:decimal">

The [3][2] element of the PDB SCALE matrix.
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="scale33" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:decimal">

mapping to a specific external database.
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="xref_domain_name" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:string">
                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">
The domain name defined by the external database.
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
               </xsd:all>
               <xsd:attribute name="asym_id" use="required" type="xsd:string">
                  <xsd:annotation>
                     <xsd:documentation xml:lang="en">
This data item is a pointer to attribute id in category struct_asym in the
 STRUCT_ASYM category.
1
A
2B3
                     </xsd:documentation>
                  </xsd:annotation>
               </xsd:attribute>
               <xsd:attribute name="entity_id" use="required" type="xsd:string">
                  <xsd:annotation>
                     <xsd:documentation xml:lang="en">
This data item is a pointer to attribute id in category entity in the ENTITY category. 
                     </xsd:documentation>
                  </xsd:annotation>
               </xsd:attribute>
               <xsd:attribute name="seq_id" use="required" type="xsd:integer">
                  <xsd:annotation>
                     <xsd:documentation xml:lang="en">
This data item is an effective pointer to attribute num in category entity_poly_seq in the
 ENTITY_POLY_SEQ category.
                     </xsd:documentation>
                  </xsd:annotation>
               </xsd:attribute>
               <xsd:attribute name="seq_id_ordinal" use="required" type="xsd:integer">
                  <xsd:annotation>
                     <xsd:documentation xml:lang="en">
The value of pdbx_sifts_xref_db.seq_id_ordinal identifies a distinct residue specific cross-reference record
in the _pdbx_sifts_xref_db category.
                     </xsd:documentation>
                  </xsd:annotation>
               </xsd:attribute>
            </xsd:complexType>
         </xsd:element>
      </xsd:sequence>
   </xsd:complexType>

   <xsd:complexType name="pdbx_sifts_xref_db_segmentsType">
      <xsd:annotation>
         <xsd:documentation xml:lang="en">
pdbx_sifts_xref_db_segments describes residue-range based cross-references to external databases.

    Example 1 -
&lt;PDBx:pdbx_sifts_xref_db_segmentsCategory&gt;
   &lt;PDBx:pdbx_sifts_xref_db_segments asym_id=&quot;A&quot; entity_id=&quot;1&quot; instance_id=&quot;1&quot; segment_id=&quot;1&quot; seq_id_end=&quot;252&quot; seq_id_start=&quot;26&quot; xref_db=&quot;SCOP2B&quot; xref_db_acc=&quot;8102030&quot;&gt;
      &lt;PDBx:domain_name&gt;SF&lt;/PDBx:domain_name&gt;
   &lt;/PDBx:pdbx_sifts_xref_db_segments&gt;
&lt;/PDBx:pdbx_sifts_xref_db_segmentsCategory&gt;


         </xsd:documentation>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element name="pdbx_sifts_xref_db_segments" minOccurs="0" maxOccurs="unbounded">
            <xsd:complexType>
               <xsd:all>
                  <xsd:element name="domain_name" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:string">
                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">
The domain name defined by the external database.
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
               </xsd:all>
               <xsd:attribute name="asym_id" use="required" type="xsd:string">
                  <xsd:annotation>
                     <xsd:documentation xml:lang="en">
This data item is a pointer to attribute id in category struct_asym in the
 STRUCT_ASYM category.
1
A
2B3
                     </xsd:documentation>
                  </xsd:annotation>
               </xsd:attribute>
               <xsd:attribute name="entity_id" use="required" type="xsd:string">
                  <xsd:annotation>
                     <xsd:documentation xml:lang="en">
This data item is a pointer to attribute id in category entity in the ENTITY category. 
                     </xsd:documentation>
                  </xsd:annotation>
               </xsd:attribute>
               <xsd:attribute name="instance_id" use="required" type="xsd:integer">
                  <xsd:annotation>
                     <xsd:documentation xml:lang="en">
The instance identifier defined by the external database.
                     </xsd:documentation>
                  </xsd:annotation>
               </xsd:attribute>
               <xsd:attribute name="segment_id" use="required" type="xsd:integer">
                  <xsd:annotation>
                     <xsd:documentation xml:lang="en">
The segment identifier defined by the external database.

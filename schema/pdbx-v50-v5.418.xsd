                        <xsd:documentation xml:lang="en">
The mailing address of the author of the data block to whom
correspondence should be addressed, state or province.
                             New Jersey
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
               </xsd:all>
               <xsd:attribute name="id" use="required">

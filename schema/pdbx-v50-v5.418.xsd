   &lt;/PDBx:pdbx_nmr_exptl_sample&gt;
&lt;/PDBx:pdbx_nmr_exptl_sampleCategory&gt;


         </xsd:documentation>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element name="pdbx_nmr_exptl_sample" minOccurs="0" maxOccurs="unbounded">
            <xsd:complexType>
               <xsd:all>
                  <xsd:element name="concentration" minOccurs="0" maxOccurs="1" nillable="true">
                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">
The concentration value of the component.
2.0
2.7
0.01
                        </xsd:documentation>
                     </xsd:annotation>
                     <xsd:simpleType>
                        <xsd:restriction base="xsd:decimal">
                           <xsd:minInclusive value="0" />
                        </xsd:restriction>
                     </xsd:simpleType>
                  </xsd:element>
                  <xsd:element name="concentration_err" minOccurs="0" maxOccurs="1" nillable="true">
                     <xsd:annotation>

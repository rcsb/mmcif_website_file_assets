      &lt;PDBx:length_c_esd&gt;0.06&lt;/PDBx:length_c_esd&gt;
      &lt;PDBx:volume&gt;234237&lt;/PDBx:volume&gt;
   &lt;/PDBx:cell&gt;
&lt;/PDBx:cellCategory&gt;



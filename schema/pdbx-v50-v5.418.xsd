   &lt;PDBx:pdbx_struct_assembly_gen assembly_id=&quot;2&quot; asym_id_list=&quot;B&quot; oper_expression=&quot;2&quot;&gt;&lt;/PDBx:pdbx_struct_assembly_gen&gt;

                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="pdbx_ptnr3_auth_comp_id" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:string">
                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">


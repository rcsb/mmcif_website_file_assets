                        <xsd:documentation xml:lang="en">
Number of protein atoms included in refinement
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="pdbx_number_atoms_solvent" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:integer">
                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">
Number of solvent atoms used in refinement
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="pdbx_number_atoms_total" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:integer">
                     <xsd:annotation>

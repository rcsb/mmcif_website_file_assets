&lt;/PDBx:citation_editorCategory&gt;


         </xsd:documentation>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element name="citation_editor" minOccurs="0" maxOccurs="unbounded">
            <xsd:complexType>
               <xsd:all>
                  <xsd:element name="ordinal" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:integer">
                     <xsd:annotation>

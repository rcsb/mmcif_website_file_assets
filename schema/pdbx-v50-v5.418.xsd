                        <xsd:documentation xml:lang="en">
The units of pressure at which NMR data were collected.
Pa
atm
Torr
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="temperature" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:string">

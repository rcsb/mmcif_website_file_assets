                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="unp_acc" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:string">
                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">
The UniProt accession code for the mapped entry
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="unp_instance_id" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:integer">
                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">
The pdbx_sifts_xref_db UniProt instance ID refers to distinct UniProt residue mappings for a given
position (i.e. the same segment, residue, asym, &amp; entity).
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="unp_num" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:integer">
                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">
The sequence position of the UniProt entry that corresponds
to the residue mapping.
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="unp_res" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:string">
                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">

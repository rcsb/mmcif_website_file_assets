   &lt;PDBx:pdbx_chem_comp_atom_coordination geometry_id=&quot;1&quot; provenance=&quot;MetalCoord&quot;&gt;
      &lt;PDBx:atom_id&gt;V&lt;/PDBx:atom_id&gt;
      &lt;PDBx:comp_id&gt;VO4&lt;/PDBx:comp_id&gt;
      &lt;PDBx:geometry_abbr&gt;TET&lt;/PDBx:geometry_abbr&gt;
      &lt;PDBx:geometry_calculated&gt;tetrahedral&lt;/PDBx:geometry_calculated&gt;
      &lt;PDBx:geometry_generic&gt;tetrahedral&lt;/PDBx:geometry_generic&gt;
      &lt;PDBx:number&gt;4&lt;/PDBx:number&gt;
      &lt;PDBx:representative_entry_id&gt;1VNH&lt;/PDBx:representative_entry_id&gt;
   &lt;/PDBx:pdbx_chem_comp_atom_coordination&gt;
   &lt;PDBx:pdbx_chem_comp_atom_coordination geometry_id=&quot;2&quot; provenance=&quot;FindGeo&quot;&gt;
      &lt;PDBx:atom_id&gt;V&lt;/PDBx:atom_id&gt;
      &lt;PDBx:comp_id&gt;VO4&lt;/PDBx:comp_id&gt;
      &lt;PDBx:geometry_abbr&gt;TBP&lt;/PDBx:geometry_abbr&gt;
      &lt;PDBx:geometry_calculated&gt;trigonal bipyramid&lt;/PDBx:geometry_calculated&gt;
      &lt;PDBx:geometry_generic&gt;trigonal bipyramidal&lt;/PDBx:geometry_generic&gt;
      &lt;PDBx:number&gt;5&lt;/PDBx:number&gt;
      &lt;PDBx:representative_entry_id&gt;1RPT&lt;/PDBx:representative_entry_id&gt;
   &lt;/PDBx:pdbx_chem_comp_atom_coordination&gt;
   &lt;PDBx:pdbx_chem_comp_atom_coordination geometry_id=&quot;2&quot; provenance=&quot;MetalCoord&quot;&gt;
      &lt;PDBx:atom_id&gt;V&lt;/PDBx:atom_id&gt;

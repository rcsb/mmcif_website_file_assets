      &lt;PDBx:publ_flag&gt;yes&lt;/PDBx:publ_flag&gt;
      &lt;PDBx:value&gt;111.6&lt;/PDBx:value&gt;
      &lt;PDBx:value_esd&gt;0.2&lt;/PDBx:value_esd&gt;
   &lt;/PDBx:geom_angle&gt;

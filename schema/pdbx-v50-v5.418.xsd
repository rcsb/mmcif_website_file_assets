                           </xsd:extension>
                        </xsd:simpleContent>
                     </xsd:complexType>
                  </xsd:element>
                  <xsd:element name="psi" minOccurs="0" maxOccurs="1" nillable="true">
                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">
The value in degrees of the main-chain torsion angle psi.

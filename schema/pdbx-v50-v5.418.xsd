                           <xsd:enumeration value="Not defined" />
                        </xsd:restriction>
                     </xsd:simpleType>
                  </xsd:element>
                  <xsd:element name="pressure" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:string">

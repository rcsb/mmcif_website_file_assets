                  </xsd:element>
                  <xsd:element name="pdbx_ptnr1_leaving_atom_id" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:string">
                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">
The leaving atom that is removed from first atom making the linkage.
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="pdbx_ptnr1_mod_name" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:string">
                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">
The abbreviation of the modifier group.
bromine atom
BR
cis-platinum-(NH3)2
PT(NH3)2
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="pdbx_ptnr1_replaced_atom" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:string">
                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">
The name of the atom which got replaced by the modifier.
O4*
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="pdbx_ptnr1_standard_comp_id" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:string">
                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">

A placeholder for the standard residue name found in
the MODRES record of a PDB file.

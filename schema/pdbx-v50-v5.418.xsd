   &lt;/PDBx:citation&gt;
   &lt;PDBx:citation id=&quot;4&quot;&gt;
      &lt;PDBx:book_id_ISBN xsi:nil=&quot;true&quot; /&gt;
      &lt;PDBx:book_publisher xsi:nil=&quot;true&quot; /&gt;
      &lt;PDBx:book_title xsi:nil=&quot;true&quot; /&gt;

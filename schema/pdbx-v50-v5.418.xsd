                        <xsd:documentation xml:lang="en">
Unit-cell angle alpha of the reported structure in degrees.
                        </xsd:documentation>
                     </xsd:annotation>
                     <xsd:simpleType>
                        <xsd:restriction base="xsd:decimal">

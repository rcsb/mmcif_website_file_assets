      &lt;PDBx:asym_id_list&gt;A,B,C&lt;/PDBx:asym_id_list&gt;
      &lt;PDBx:oper_expression&gt;2&lt;/PDBx:oper_expression&gt;
   &lt;/PDBx:pdbx_struct_assembly_gen_depositor_info&gt;

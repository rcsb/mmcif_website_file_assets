                        <xsd:documentation xml:lang="en">
The pressure at which NMR data were collected.
ambient
1atm
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="pressure_err" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:decimal">

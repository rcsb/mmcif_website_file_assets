   &lt;/PDBx:em_layer_lines_depositor_info&gt;
&lt;/PDBx:em_layer_lines_depositor_infoCategory&gt;


         </xsd:documentation>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element name="em_layer_lines_depositor_info" minOccurs="0" maxOccurs="unbounded">

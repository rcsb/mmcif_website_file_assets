                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
               </xsd:all>
               <xsd:attribute name="symbol" use="required" type="xsd:string">
                  <xsd:annotation>
                     <xsd:documentation xml:lang="en">

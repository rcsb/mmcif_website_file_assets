                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="unp_segment_id" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:integer">
                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">
The pdbx_sifts_xref_db UniProt segment ID refers to the distinct contiguous residue-range segments with a
UniProt residue mapping.
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="xref_db_acc" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:string">
                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">
The accession code related to the additional external database entry.
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="xref_db_instance_id" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:integer">
                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">
The instance identifier defined by the external database.
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="xref_db_name" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:string">
                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">
The name of additional external databases with residue level mapping.
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="xref_db_segment_id" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:integer">
                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">

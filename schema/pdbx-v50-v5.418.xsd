                     </xsd:simpleType>
                  </xsd:element>
                  <xsd:element name="exptl_distance_term" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:decimal">
                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">
The final force constant for distance (NOEs) constraints

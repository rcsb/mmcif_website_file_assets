                        <xsd:documentation xml:lang="en">

Estimate of the standard error for the value for the sample pressure.
0.01
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="pressure_units" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:string">

   <xsd:complexType name="pdbx_chem_comp_relatedType">
      <xsd:annotation>
         <xsd:documentation xml:lang="en">
PDBX_CHEM_COMP_RELATED describes the relationship between two chemical components.

    Example 1 -
&lt;PDBx:pdbx_chem_comp_relatedCategory&gt;
   &lt;PDBx:pdbx_chem_comp_related comp_id=&quot;SGN&quot; related_comp_id=&quot;GLC&quot; relationship_type=&quot;Carbohydrate core&quot;&gt;
   &lt;/PDBx:pdbx_chem_comp_related&gt;
&lt;/PDBx:pdbx_chem_comp_relatedCategory&gt;


         </xsd:documentation>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element name="pdbx_chem_comp_related" minOccurs="0" maxOccurs="unbounded">
            <xsd:complexType>
               <xsd:all>
                  <xsd:element name="details" minOccurs="0" maxOccurs="1" nillable="true" type="xsd:string">
                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">
Describes the type of relationship
                        </xsd:documentation>
                     </xsd:annotation>
                  </xsd:element>
               </xsd:all>
               <xsd:attribute name="comp_id" use="required" type="xsd:string">
                  <xsd:annotation>
                     <xsd:documentation xml:lang="en">
The chemical component for which this relationship applies.
                     </xsd:documentation>
                  </xsd:annotation>
               </xsd:attribute>
               <xsd:attribute name="related_comp_id" use="required" type="xsd:string">
                  <xsd:annotation>
                     <xsd:documentation xml:lang="en">
The related chemical component for which this chemical component is based.
                     </xsd:documentation>
                  </xsd:annotation>
               </xsd:attribute>
               <xsd:attribute name="relationship_type" use="required">
                  <xsd:annotation>
                     <xsd:documentation xml:lang="en">
Describes the type of relationship
                     </xsd:documentation>
                  </xsd:annotation>
                  <xsd:simpleType>
                     <xsd:restriction base="xsd:string">
                        <xsd:enumeration value="Carbohydrate core" />
                        <xsd:enumeration value="Precursor" />
                     </xsd:restriction>
                  </xsd:simpleType>
               </xsd:attribute>
            </xsd:complexType>
         </xsd:element>
      </xsd:sequence>
   </xsd:complexType>

   <xsd:complexType name="pdbx_chem_comp_subcomponent_entity_listType">
      <xsd:annotation>
         <xsd:documentation xml:lang="en">
Data items in the pdbx_chem_comp_subcomponent_entity_list category
list the constituent chemical entities and entity features in this chemical component.

    Example 1 -
&lt;PDBx:pdbx_chem_comp_subcomponent_entity_listCategory&gt;

                        <xsd:enumeration value="Image" />
                        <xsd:enumeration value="Half map" />
                        <xsd:enumeration value="Additional map" />
                        <xsd:enumeration value="FSC" />
                        <xsd:enumeration value="Mask" />
                        <xsd:enumeration value="EM metadata" />

         </xsd:documentation>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element name="pdbx_inhibitor_info" minOccurs="0" maxOccurs="unbounded">
            <xsd:complexType>
               <xsd:all>
                  <xsd:element name="name" minOccurs="1" maxOccurs="1" type="xsd:string">
                     <xsd:annotation>
                        <xsd:documentation xml:lang="en">
Name of inhibitor.
N-ACETYL-DEOXYTHYMIDINE
ADP
